static func _hell_knight_fx(skel: Skeleton3D, def: Dictionary) -> void:
	# The blade's fire is in its emissive lava cracks and burning edge; a
	# small flickering light makes it cast a warm glow on the armour.
	for c in skel.get_children():
		if c is BoneAttachment3D and c.bone_name == "handslot.r" and c.has_meta("gear"):
			var l := OmniLight3D.new()
			l.light_color = ModelLib._col(def.get("emission", [1, 0.35, 0.06]))
			l.light_energy = 0.6
			l.omni_range = 1.8
			l.light_volumetric_fog_energy = 0.0
			l.position = Vector3(0, 0.8, 0)
			c.add_child(l)
			var f := LightFlicker.new()
			f.light = l
			c.add_child(f)
